# Generate a unique secret with openssl rand -base64 48.
DATABASE_URL=postgresql://pitchmate:local-development-only@127.0.0.1:5432/pitchmate
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
APP_URL=http://localhost:3000

EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

POSTGRES_USER=pitchmate
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=pitchmate
POSTGRES_PORT=5432

# Optional direct connection for Prisma migrations when DATABASE_URL uses a pooler.
DIRECT_DATABASE_URL=
# Only set at an ingress that overwrites this header with the actual client IP.
AUTH_TRUSTED_IP_HEADER=

# Optional disposable database for automated tests.
TEST_DATABASE_URL=

# Set all three for Cloudinary. Loopback deployments can use local image files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
SLOT_GENERATION_DAYS=30
MAX_VENUE_IMAGES=10
MAX_IMAGE_SIZE_MB=5
# Optional for the scheduled HTTP job. Use a separate high-entropy secret.
SLOT_JOB_SECRET=
# At least 16 characters for the local-only demonstration accounts.
DEMO_ACCOUNT_PASSWORD=
# Optional override for loopback image storage.
PITCHMATE_MEDIA_DIR=

# Use Razorpay test credentials when developing payment flows.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BOOKING_HOLD_MINUTES=10
MAX_ACTIVE_HOLDS_PER_USER=1
PLATFORM_FEE_PAISE=5000
TAX_RATE_BPS=0
INTERNAL_JOB_SECRET=
# Loopback test harness only. Requires Razorpay test credentials.
RAZORPAY_MOCK_URL=

# Phase 4 operational settings
CHECK_IN_EARLY_MINUTES=30
BOOKING_REMINDER_MINUTES=1440,120

# Hosted environment and operational controls
APP_ENV=development
DB_POOL_MAX=10
CSP_MODE=report-only
LOG_LEVEL=info
SUPPORT_EMAIL=
CRON_SECRET=
ENABLE_LIVE_PAYMENTS=false
# Optional external OpenTelemetry collector. Never expose exporter credentials to browser code.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
