# Generate a unique secret with openssl rand -base64 48.
DATABASE_URL=postgresql://pitchmate:local-development-only@127.0.0.1:5432/pitchmate
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
APP_URL=http://localhost:3000

EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

POSTGRES_USER=pitchmate
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=pitchmate
POSTGRES_PORT=5432

# Optional direct connection for Prisma migrations when DATABASE_URL uses a pooler.
DIRECT_DATABASE_URL=
# Only set at an ingress that overwrites this header with the actual client IP.
AUTH_TRUSTED_IP_HEADER=

# Optional disposable database for automated tests.
TEST_DATABASE_URL=
