{
  "name": "pitchmate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --webpack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "prisma generate && vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:provision-admin": "bun prisma/provision-admin.ts",
    "slots:extend": "bun scripts/extend-availability.ts",
    "db:seed:demo": "bun prisma/seed.ts --demo",
    "db:verify-owner": "bun scripts/verify-owner.ts",
    "bookings:work": "bun scripts/booking-jobs.ts",
    "format:check": "prettier --check .",
    "test:unit": "prisma generate && vitest run tests/unit",
    "test:integration": "prisma generate && vitest run tests/integration",
    "test:coverage": "prisma generate && vitest run --coverage",
    "test:security": "prisma generate && vitest run tests/unit/security.test.ts && bun audit",
    "test:load": "bun scripts/load.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:audit": "bun scripts/audit-db.ts",
    "analyze": "next experimental-analyze --output",
    "smoke": "bun scripts/smoke.ts",
    "db:restore:drill": "bun scripts/restore-drill.ts",
    "test:contention": "bun scripts/booking-contention.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "7.0.9",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/otel": "2.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "18.0.10",
    "leaflet": "1.9.4",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "next-themes": "0.4.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "razorpay": "2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "recharts": "3.11.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.1.1"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
